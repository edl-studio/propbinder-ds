
    .test-container {
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    
    .test-image {
      width: 100%;
      max-width: 400px;
      border-radius: 8px;
      cursor: pointer;
      transition: transform 0.2s;
    }
    
    .test-image:active {
      transform: scale(0.98);
    }
  