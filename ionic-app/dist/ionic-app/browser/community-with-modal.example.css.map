
    .post-feed {
      display: flex;
      flex-direction: column;
      max-width: 640px;
    }
    
    .clickable-image {
      cursor: pointer;
      transition: transform 0.2s ease, opacity 0.2s ease;
      border-radius: 8px;
      display: block;
      width: 100%;
      aspect-ratio: 16/9;
      object-fit: cover;
    }
    
    .clickable-image:active {
      transform: scale(0.98);
      opacity: 0.9;
    }
  